{
  "name": "tranche-master",
  "version": "1.0.0",
  "description": "Calculator for the French income tax (Impôt sur le Revenu): tax bracket from income, or income from a tax threshold.",
  "license": "MIT",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "jest --coverage --silent && npx js-coverage-badges badges_output mode:chart",
    "test:updater": "node js/test_updater.js",
    "update:tax-data": "node js/update_tax_data.js"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 65,
        "lines": 70,
        "statements": 70
      }
    },
    "transform": {
      "\\.[jt]sx?$": "babel-jest"
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "axios": "^1.13.6",
    "babel-jest": "^30.2.0",
    "cheerio": "^1.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "js-coverage-badges": "^1.1.1"
  }
}
